   "source": [
    "#### Write a Python program using a function to check whether a student has passed or failed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fd552b48",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "70\n",
      "Pass\n"
     ]
    }
   ],
   "source": [
    "def check_result(marks):\n",
    "\n",
    "    if marks >= 40:\n",
    "        return \"Pass\"\n",
    "    else:\n",
    "        return \"Fail\"\n",
    "\n",
    "\n",
    "marks = int(input(\"Enter your marks: \"))\n",
    "\n",
    "result = check_result(marks)\n",
    "\n",
    "print(result)"
   ]
  }
 ],
