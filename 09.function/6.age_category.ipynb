    "def age_catogory(age):\n",
    "    if age < 13:\n",
    "        return \"Child\"\n",
    "    elif age <= 19:\n",
    "        return \"Teenager\"\n",
    "    elif age > 20:\n",
    "        return \"Adult\"\n",
    "\n",
    "age = int(input(\"Enter Your Age:\"))\n",
    "\n",
    "result=age_catogory(age)\n",
    "print(age)\n",
    "print(result)"
   ]
  }
