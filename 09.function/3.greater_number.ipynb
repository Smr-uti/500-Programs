   "source": [
    "def greater_number(a, b):\n",
    "\n",
    "    if a > b:\n",
    "        return a\n",
    "    else:\n",
    "        return b\n",
    "\n",
    "number1 = 20\n",
    "number2 = 10\n",
    "\n",
    "result = greater_number(number1, number2)\n",
    "print(result)"
   ]
