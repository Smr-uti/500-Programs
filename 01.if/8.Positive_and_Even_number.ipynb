   "source": [
    "#### 4. Positive and Even Number:- Write a Python program to check whether a given number is both positive and even."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "1c6e68ff",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number is Positive and Even\n"
     ]
    }
   ],
   "source": [
    "number = 10\n",
    "if number > 0 and number % 2 == 0:\n",
    "    print(\"Number is Positive and Even\")"
   ]
  }
