   "source": [
    "#### Write a Python program to check whether a given number is: | Positive | Even | Greater than 10| If all three conditions are true, print: Valid number"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ca5d69ad",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "20\n",
      "Valid Number\n"
     ]
    }
   ],
   "source": [
    "number = 20\n",
    "\n",
    "if number > 0 and number % 2 == 0 and number > 10:\n",
    "    print(number)\n",
    "    print(\"Valid Number\")"
   ]
  }
