   "source": [
    "#### 8. Check if Number is divisible by 5:Check if a number can be divided by 5 perfectly."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "981acfbf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "90\n",
      "The number is divisible by 5\n"
     ]
    }
   ],
   "source": [
    "number=int(input(\"Enter the number:\"))\n",
    "print(number)\n",
    "\n",
    "if number % 5==0:\n",
    "    print(\"The number is divisible by 5\")\n",
    "else:\n",
    "    print(\"The number is not divisible by 5\")"
   ]
  }
