   "source": [
    "is_raining = input(\"Is it raining? (yes/no): \").lower()\n",
    "\n",
    "if is_raining == \"yes\":\n",
    "    print(\"Take an umbrella.\")\n",
    "else:\n",
    "    print(\"No need for an umbrella.\")"
