      "It is the weekend, Time to Relax!\n"
     ]
    }
   ],
   "source": [
    "day=input(\"Enter the day:\")\n",
    "print(day)\n",
    "\n",
    "if day == \"saturday\" or day == \"sunday\":\n",
    "    print(\"It is the weekend, Time to Relax!\")\n",
    "else:\n",
    "    print(\"Its a weekday. Keep Working Hard.\")"
   ]
